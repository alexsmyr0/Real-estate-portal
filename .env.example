# Flask app
APP_HOST=0.0.0.0
APP_PORT=8080
APP_DEBUG=true

# Local MySQL container
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=admin
MYSQL_DATABASE=homefinder
