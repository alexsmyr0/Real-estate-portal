# Flask app
APP_HOST=0.0.0.0
APP_PORT=8080
APP_DEBUG=true

# Local MySQL container
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=admin
MYSQL_DATABASE=homefinder
MYSQL_USER=homefinder_app
MYSQL_PASSWORD=admin

# App DB connection
DB_SCHEME=mysql
DB_HOST=127.0.0.1

# Optional: override the full DB URL if a specific library needs it.
# DATABASE_URL=mysql://homefinder_app:admin@127.0.0.1:3306/homefinder

# Email delivery
# Default is safe for local development, tests, and demos.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=HomeFinder <no-reply@homefinder.local>

# SMTP provider example for production-like environments.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=replace-with-provider-username
# EMAIL_HOST_PASSWORD=replace-with-provider-password
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# EMAIL_TIMEOUT=10
